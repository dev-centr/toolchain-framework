{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcentr.org/schemas/tcf/adapter.schema.json",
  "title": "Toolchain Framework adapter stub",
  "type": "object",
  "additionalProperties": false,
  "required": ["ecosystem", "protocolVersion", "capabilities"],
  "properties": {
    "ecosystem": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string" },
    "protocolVersion": { "type": "integer", "minimum": 1 },
    "entrypoint": { "type": "string" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "bootstrap",
          "pin-resolve",
          "health",
          "repair",
          "upgrade-rollback",
          "surface-parity"
        ]
      }
    },
    "communityBridges": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  }
}
