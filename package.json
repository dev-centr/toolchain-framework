{
  "name": "@dev-centr/toolchain-framework",
  "version": "0.1.0",
  "private": false,
  "description": "Toolchain Framework (TCF): schemas and validators for Toolchain Control Plane compliance",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "validate": "node scripts/validate.mjs",
    "ci": "pnpm run build && pnpm run validate"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
